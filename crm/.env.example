# ─────────────────────────────────────────────────────────────────
# CRM de Jose I. Tobon — variables de entorno
# Copia este archivo como .env y llena lo que necesites.
# NUNCA subas el archivo .env al repositorio.
# ─────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────
# PostgreSQL. En Supabase: Project Settings → Database → Connection string (URI).
# Si la dejas vacia, la aplicacion levanta un Postgres embebido en .pgdata/ para
# probar sin instalar nada. Eso sirve para una demo, no para trabajar de verdad:
# no soporta dos procesos a la vez y no sobrevive bien a un apagon.
DATABASE_URL=postgres://usuario:clave@localhost:5432/jit_crm
# DATABASE_POOL_MAX=10

# ── Sesiones (obligatorio) ───────────────────────────────────────
# Firma la cookie de sesion. Minimo 24 caracteres, aleatorios.
# Generar con:  openssl rand -base64 48
AUTH_SECRET=

# ── Cifrado de tokens (necesario para conectar el correo) ────────
# Con esta llave se cifran los tokens de Google antes de guardarlos.
# Sin ella el CRM funciona, pero se niega a conectar cuentas de correo.
# Generar con:  openssl rand -base64 48
ENCRYPTION_KEY=

# ── URL publica de la aplicacion ─────────────────────────────────
# Se usa para armar la URL de retorno de Google. En produccion, el dominio real.
APP_URL=http://localhost:3000

# ── Correo: Google Workspace / Gmail (opcional) ──────────────────
# Pasos exactos en docs/correo-gmail.md y en Ajustes → Correo.
# Sin esto, la pantalla de Correo dice "Integracion pendiente de configuracion"
# y el resto del CRM sigue igual.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: por defecto es ${APP_URL}/api/correo/google/callback
# GOOGLE_REDIRECT_URI=

# ── Entrada del agente de WhatsApp (opcional) ────────────────────
# Clave compartida con el agente Benjamin. Sin ella, /api/ingesta/whatsapp
# responde 503 y no procesa nada: es preferible a quedar abierto.
# Generar con:  openssl rand -hex 32
CRM_INGEST_SECRET=

# ── Asistente comercial con IA (opcional) ────────────────────────
# Solo redacta el resumen de los hallazgos. Los hallazgos se calculan igual sin
# esta clave, con los datos del CRM.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Almacenamiento de documentos ─────────────────────────────────
# Por defecto los archivos se guardan en la carpeta storage/ del servidor.
# Para usar Supabase Storage, llena estas tres y crea el bucket (privado).
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=jit-crm
# STORAGE_DIR=storage
# MAX_FILE_BYTES=15728640

# ── Otros ────────────────────────────────────────────────────────
# Indicativo que se asume cuando un telefono viene sin el.
DEFAULT_COUNTRY_CODE=57
# Contrasena inicial de los usuarios que crean las semillas.
SEED_PASSWORD=TobonCRM2026
