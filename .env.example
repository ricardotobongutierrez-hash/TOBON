# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:  cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic ──────────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# claude-opus-5 ($5/$25 por millon)  claude-sonnet-5 ($2/$10)  claude-haiku-4-5 ($1/$5)
ANTHROPIC_MODEL=claude-sonnet-5

# Cachea el contexto del negocio: las lecturas cuestan 0.1x la entrada.
# Dejalo en true salvo que estes depurando.
ANTHROPIC_CACHE=true
# Esfuerzo de razonamiento: low | medium | high. Vacio = no enviar el parametro.
ANTHROPIC_EFFORT=low
# Opcional, default 4096. El razonamiento interno cuenta contra este tope.
# ANTHROPIC_MAX_TOKENS=4096

# ── Proveedor de WhatsApp ──────────────────────────────────
WHATSAPP_PROVIDER=zernio

# ── Zernio ─────────────────────────────────────────────────
# Crear cuenta y conectar WhatsApp en: https://zernio.com
# La API key se genera en Settings -> API Keys (empieza con "sk_")
ZERNIO_API_KEY=
# El webhook secret lo inventas tu. Verifica que los mensajes vienen de Zernio
# y no de cualquiera que conozca tu URL. Cargalo ANTES de atender clientes reales.
ZERNIO_WEBHOOK_SECRET=
# Opcional: solo se usa para chequear la conexion al arrancar.
ZERNIO_ACCOUNT_ID=

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ──────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
